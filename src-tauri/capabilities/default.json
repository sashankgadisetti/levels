{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main and system windows",
  "windows": ["main", "system"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "sql:default",
    "sql:allow-execute",
    "notification:default",
    "global-shortcut:default",
    "autostart:default",
    "store:default",
    "opener:default"
  ]
}
